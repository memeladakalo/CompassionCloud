@{
    ViewData["Title"] = "Donor Dashboard";
    var donations = Model as List<CompassionCloud.Models.Donation>;
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-2 sidebar bg-light min-vh-100 p-3">
            <h5 class="text-primary mb-4">☁️ Compassion Cloud</h5>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link active" href="#">📊 Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Donation" asp-action="Index">❤️ Donate</a></li>
                <li class="nav-item"><a class="nav-link" href="#">💳 My Donations</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="TaxCertificate" asp-action="Generate">📄 Tax Certificates</a></li>
                <li class="nav-item"><a class="nav-link" href="#">👤 Profile</a></li>
                <li class="nav-item"><a class="nav-link" href="#">⚙️ Settings</a></li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="col-md-10 p-4">
            <h2>Welcome, @User.Identity.Name! 👋</h2>
            <p class="text-muted">Together we can make a difference.</p>

            <!-- Stat Cards -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card stat-card">
                        <div class="card-body">
                            <small>Total Donated</small>
                            <h3>R @ViewBag.TotalDonated.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card">
                        <div class="card-body">
                            <small>Recurring Donations</small>
                            <h3>@ViewBag.RecurringCount</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card">
                        <div class="card-body">
                            <small>Tax Certificates</small>
                            <h3>@ViewBag.CertificateCount</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Donations -->
            <div class="card">
                <div class="card-header bg-white">
                    <h5>Recent Donations</h5>
                </div>
                <div class="card-body p-0">
                    @if (donations != null && donations.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead><tr><th>Cause</th><th>Amount</th><th>Type</th><th>Date</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var d in donations.Take(5))
                                {
                                    <tr>
                                        <td>Disaster Relief Fund</td>
                                        <td>@d.Currency @d.Amount.ToString("N0")</td>
                                        <td><span class="badge bg-secondary">@d.DonationType</span></td>
                                        <td>@d.DonationDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-success">Completed</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-center text-muted p-4">You haven't made any donations yet.</p>
                    }
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Donation" asp-action="Index" class="btn btn-primary">❤️ Donate Now</a>
            </div>
        </div>
    </div>
</div>