@{
    ViewData["Title"] = "Tax Certificate";
}

<div class="container py-4">
    <h2>Tax Certificate</h2>
    <p class="text-muted">Generate your tax certificate for donations.</p>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Generate" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Tax Year</label>
                            <select name="taxYear" class="form-select">
                                <option value="2026">2026</option>
                                <option value="2025">2025</option>
                                <option value="2024">2024</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary">Generate Certificate</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6 text-center">
            <div class="certificate-preview p-4 border rounded">
                <h4>📄</h4>
                <p class="text-muted">Your tax certificate will appear here</p>
            </div>
        </div>
    </div>
</div>