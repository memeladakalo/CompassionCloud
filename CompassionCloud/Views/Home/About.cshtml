@{
    ViewData["Title"] = "About";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <h1>🌍 About Compassion Cloud</h1>
        <hr />

        <div class="card shadow">
            <div class="card-body">
                <h4>Our Mission</h4>
                <p>
                    <strong>Compassionate Cloud</strong> is a disaster-relief management system developed
                    in partnership with <strong>Gift of the Givers</strong>, Africa's largest disaster
                    relief organization.
                </p>

                <h4 class="mt-4">What We Do</h4>
                <ul>
                    <li>Coordinate volunteers during emergency responses</li>
                    <li>Track donations and ensure transparent resource allocation</li>
                    <li>Document disaster incidents and relief efforts</li>
                    <li>Provide real-time updates to stakeholders</li>
                    <li>Generate tax certificates for donors</li>
                </ul>

                <h4 class="mt-4">💡 The Gift of the Givers</h4>
                <p>
                    Founded in 1992, Gift of the Givers is the largest disaster relief organization on the
                    African continent, providing aid in over 42 countries. Our system, Compassionate Cloud,
                    is designed to support their critical work by modernizing their operations.
                </p>

                <div class="alert alert-primary mt-4">
                    <strong>✨ Prototype Version:</strong> This system is currently in development.
                    The features demonstrated here are functional prototypes showcasing the design and
                    core functionality of the future platform.
                </div>
            </div>
        </div>
    </div>
</div>